    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json.data;\n\nconst action = data.Action.toLowerCase().trim();\n\n// Date comes as \"2026-04-18\" from date picker\nconst [yyyy, mm, dd] = data.Date.split('-');\nconst formattedDate = `${mm}/${dd}/${yyyy}`; // \"04/18/2026\" for Google Sheets\n\nconst date = new Date(`${yyyy}-${mm}-${dd}`);\nconst monthName = date.toLocaleString('default', { month: 'long' });\nconst sheetName = `${monthName} ${yyyy}`; // \"April 2026\"\n\nreturn [{\n  json: {\n    action: action,\n    date: formattedDate,\n    text: data.Text || '',\n    sheetName: sheetName\n  }\n}];"
      },
