    {
      "parameters": {
        "jsCode": "const data = $input.first().json.data;\nconst action = data.Action.toLowerCase().trim();\nconst [yyyy, mm, dd] = data.Date.split('-');\nconst formattedDate = `${parseInt(mm)}/${parseInt(dd)}/${yyyy}`; // \"5/5/2026\"\nconst date = new Date(`${yyyy}-${mm}-${dd}`);\nconst monthName = date.toLocaleString('default', { month: 'long' });\nconst sheetName = `${monthName} ${yyyy}`;\nreturn [{\n  json: {\n    action: action,\n    date: formattedDate,\n    text: data.Text || '',\n    sheetName: sheetName\n  }\n}];"
      },
