    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(r => r.json);\nconst targetDate = $('Format Form Input \"get by date\"').first().json.date;\n\nconst normalize = (d) => {\n  const [mm, dd, yyyy] = d.toString().trim().split('/');\n  return `${parseInt(mm)}/${parseInt(dd)}/${yyyy}`;\n};\n\nconst normalizedTarget = normalize(targetDate);\n\nconst matched = rows.filter(r => {\n  const cellDate = r['Date(M/D/YYYY)'];\n  if (!cellDate) return false;\n  return normalize(cellDate.toString()) === normalizedTarget;\n});\n\nif (matched.length === 0) {\n  return [{ json: { error: `No entries found for date: ${targetDate}` } }];\n}\n\nreturn matched.map(r => ({\n  json: {\n    date: r['Date(M/D/YYYY)'],\n    task: r['Task']\n  }\n}));"
      },
