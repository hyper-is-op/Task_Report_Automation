    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(r => r.json);\nconst withDates = rows\n  .filter(r => r['Date(M/D/YYYY)'] && r['Date(M/D/YYYY)'].toString().trim() !== '')\n  .map(r => ({ ...r, _parsed: new Date(r['Date(M/D/YYYY)']) }))\n  .filter(r => !isNaN(r._parsed))\n  .sort((a, b) => b._parsed - a._parsed);\n\nif (withDates.length === 0) {\n  return [{ json: { error: 'No valid date entries found' } }];\n}\n\nconst latestDate = withDates[0]._parsed;\nconst tenDaysAgo = new Date(latestDate);\ntenDaysAgo.setDate(tenDaysAgo.getDate() - 9);\n\nconst last10Days = withDates.filter(r => r._parsed >= tenDaysAgo);\n\nreturn last10Days.map(r => ({\n  json: {\n    date: r['Date(M/D/YYYY)'],\n    task: r['Task'],\n    totalFound: last10Days.length\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        48,
        -80
      ],
      "id": "83e217ab-9b47-4748-b497-5a2b1c9751b0",
      "name": "Get last 10 entires if possible"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json.data;\n\nconst action = data.Action.toLowerCase().trim();\n\n// Date comes as \"2026-04-18\" from date picker\nconst [yyyy, mm, dd] = data.Date.split('-');\nconst formattedDate = `${mm}/${dd}/${yyyy}`; // \"04/18/2026\" for Google Sheets\n\nconst date = new Date(`${yyyy}-${mm}-${dd}`);\nconst monthName = date.toLocaleString('default', { month: 'long' });\nconst sheetName = `${monthName} ${yyyy}`; // \"April 2026\"\n\nreturn [{\n  json: {\n    action: action,\n    date: formattedDate,\n    text: data.Text || '',\n    sheetName: sheetName\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
