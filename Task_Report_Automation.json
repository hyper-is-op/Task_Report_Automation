    {
      "parameters": {
        "jsCode": "const sheets = $('Get all sheet name').first().json.sheets;\n\nconst latestSheet = sheets\n  .map(s => ({\n    title: s.properties.title,\n    date: new Date(s.properties.title)\n  }))\n  .filter(s => !isNaN(s.date))\n  .sort((a, b) => b.date - a.date)[0];\n\nreturn [{ json: { sheetName: latestSheet.title } }];"
      },
